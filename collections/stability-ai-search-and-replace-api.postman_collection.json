  "item": [
    {
      "id": "d3776cb4-e839-469a-9cd6-d823fbe613da",
      "name": "Search and Replace",
      "description": {
        "content": "Find and replace specific objects within an image using text descriptions of what to search for and what to replace it with.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "be56a241-95dc-4f26-abac-42dc2b10ade8",
          "name": "Search and replace objects in an image",
          "request": {
            "name": "Search and replace objects in an image",
            "description": {
              "content": "Finds specific objects within an image using a text description and replaces them with new content described by a prompt. This enables targeted object replacement without manually creating masks.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2beta",
                "stable-image",
                "edit",
                "search-and-replace"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "image/jpeg"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "description": "(Required) The source image containing the objects to replace."
                },
                {
                  "key": "prompt",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) Text describing what should replace the found objects."
                },
                {
                  "key": "search_prompt",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) Text describing the objects to find and replace in the image."
                },
                {
                  "key": "negative_prompt",
                  "value": "<string>",
                  "type": "text",
                  "description": "Text describing elements to exclude from the replacement."
                },
                {
                  "key": "seed",
                  "value": "0",
                  "type": "text",
                  "description": "A value to control randomness in generation."
                },
                {
                  "key": "output_format",
                  "value": "png",
                  "type": "text",
                  "description": "The output format of the edited image. (This can only be one of jpeg,png,webp)"
                }
              ]
            }
          },
