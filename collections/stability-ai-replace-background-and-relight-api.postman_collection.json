          "name": "Replace background and adjust lighting",
          "request": {
            "name": "Replace background and adjust lighting",
            "description": {
              "content": "Replaces the background of an image with new content described by a text prompt and adjusts lighting conditions to match the new scene. The foreground subject is preserved while the background is regenerated.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2beta",
                "stable-image",
                "edit",
                "replace-background-and-relight"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "image/jpeg"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "description": "(Required) The source image whose background will be replaced."
                },
                {
                  "key": "background_prompt",
                  "value": "<string>",
                  "type": "text",
                  "description": "Text describing the new background scene and lighting conditions."
                },
                {
                  "key": "foreground_prompt",
                  "value": "<string>",
                  "type": "text",
                  "description": "Text describing any adjustments to the foreground subject."
                },
                {
                  "key": "negative_prompt",
                  "value": "<string>",
                  "type": "text",
                  "description": "Text describing elements to exclude from the result."
                },
                {
                  "key": "seed",
                  "value": "0",
                  "type": "text",
                  "description": "A value to control randomness in generation."
                },
                {
                  "key": "output_format",
                  "value": "png",
                  "type": "text",
                  "description": "The output format of the edited image. (This can only be one of jpeg,png,webp)"
                }
              ]
            }
          },
