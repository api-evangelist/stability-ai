  "item": [
    {
      "id": "ae37a4e7-39f1-4385-b8ce-efa2dde6d803",
      "name": "Sketch",
      "description": {
        "content": "Generate images from hand-drawn sketches or line drawings, guided by a text prompt to fill in details, colors, and textures.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "148e8c33-25d4-4cc2-aed8-cb269fdb60eb",
          "name": "Generate an image from a sketch",
          "request": {
            "name": "Generate an image from a sketch",
            "description": {
              "content": "Generates a detailed image from a hand-drawn sketch or line drawing. The sketch provides the structural composition while the text prompt guides the content, colors, textures, and style of the output image.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2beta",
                "stable-image",
                "control",
                "sketch"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "image/jpeg"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "description": "(Required) The sketch or line drawing image to use as structural guidance."
                },
                {
                  "key": "prompt",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) Text describing the desired output image including content, colors, textures, and style."
                },
                {
                  "key": "negative_prompt",
                  "value": "<string>",
                  "type": "text",
                  "description": "Text describing elements to exclude from the output image."
                },
                {
                  "key": "control_strength",
                  "value": "0.7",
                  "type": "text",
                  "description": "Controls how closely the output follows the input sketch. Higher values produce outputs more faithful to the sketch structure."
                },
                {
                  "key": "seed",
                  "value": "0",
                  "type": "text",
                  "description": "A value to control randomness in generation."
                },
                {
                  "key": "output_format",
                  "value": "png",
                  "type": "text",
                  "description": "The output format of the generated image. (This can only be one of jpeg,png,webp)"
                }
              ]
            }
          },
