          "name": "Remove background from an image",
          "request": {
            "name": "Remove background from an image",
            "description": {
              "content": "Automatically detects and removes the background from an image, isolating the foreground subject. Returns the image with a transparent background in PNG format or a white background in JPEG format.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2beta",
                "stable-image",
                "edit",
                "remove-background"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "image/png"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "description": "(Required) The source image from which to remove the background."
                },
                {
                  "key": "output_format",
                  "value": "png",
                  "type": "text",
                  "description": "The output format of the image. PNG supports transparency for background removal. (This can only be one of png,webp)"
                }
              ]
            }
