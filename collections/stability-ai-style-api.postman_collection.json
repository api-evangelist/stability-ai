  "item": [
    {
      "id": "759930fe-1d21-458d-b43c-fe48a74abaa6",
      "name": "Style",
      "description": {
        "content": "Generate images that adopt the visual style of a reference image while following a text prompt for content direction.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "81548b6c-a899-4fcb-b44b-54ddea159b83",
          "name": "Generate an image with style transfer",
          "request": {
            "name": "Generate an image with style transfer",
            "description": {
              "content": "Generates a new image that adopts the visual style of a reference image. The style image provides color palette, artistic technique, and aesthetic direction while the text prompt controls the subject and composition of the output.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2beta",
                "stable-image",
                "control",
                "style"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "image/jpeg"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "description": "(Required) The style reference image whose visual style will be applied to the output."
                },
                {
                  "key": "prompt",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) Text describing the subject and composition of the output image."
                },
                {
                  "key": "negative_prompt",
                  "value": "<string>",
                  "type": "text",
                  "description": "Text describing elements to exclude from the output image."
                },
                {
                  "key": "fidelity",
                  "value": "0.5",
                  "type": "text",
                  "description": "Controls how strongly the style of the reference image influences the output. Higher values produce outputs closer to the reference style."
                },
                {
                  "key": "seed",
                  "value": "0",
                  "type": "text",
                  "description": "A value to control randomness in generation."
                },
                {
                  "key": "output_format",
                  "value": "png",
                  "type": "text",
                  "description": "The output format of the generated image. (This can only be one of jpeg,png,webp)"
                }
              ]
            }
          },
          "response": [
