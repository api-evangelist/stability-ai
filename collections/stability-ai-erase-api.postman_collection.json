  "item": [
    {
      "id": "e9a7415d-f5c3-426c-aa96-01eb3f3b2597",
      "name": "Erase",
      "description": {
        "content": "Remove objects from an image by masking the area to erase and letting the AI fill in the background naturally.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "2d13f443-8709-43b7-a348-d2efc2778506",
          "name": "Erase an object from an image",
          "request": {
            "name": "Erase an object from an image",
            "description": {
              "content": "Removes an object or region from an image by providing a mask over the area to erase. The AI fills in the erased area with contextually appropriate background content that blends naturally with the surrounding image.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2beta",
                "stable-image",
                "edit",
                "erase"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "image/jpeg"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "description": "(Required) The source image containing the object to erase."
                },
                {
                  "key": "mask",
                  "type": "file",
                  "description": "A mask image indicating the region to erase. White pixels indicate areas to remove, black pixels indicate areas to preserve."
                },
                {
                  "key": "seed",
                  "value": "0",
                  "type": "text",
                  "description": "A value to control randomness in generation."
                },
                {
                  "key": "output_format",
                  "value": "png",
                  "type": "text",
                  "description": "The output format of the edited image. (This can only be one of jpeg,png,webp)"
                }
              ]
            }
          },
