                  "name": "sketch",
                  "item": [
                    {
                      "name": "Generate an image from a sketch",
                      "id": "7474fcb3-d09d-4fe6-9e0f-10039a0f210e",
                      "protocolProfileBehavior": {
                        "disableBodyPruning": true
                      },
                      "request": {
                        "method": "POST",
                        "header": [
                          {
                            "key": "Content-Type",
                            "value": "multipart/form-data"
                          },
                          {
                            "key": "Accept",
                            "value": "image/jpeg"
                          }
                        ],
                        "body": {
                          "mode": "formdata",
                          "formdata": [
                            {
                              "description": "(Required) The sketch or line drawing image to use as structural guidance.",
                              "key": "image",
                              "type": "file",
                              "value": null
                            },
                            {
                              "description": "(Required) Text describing the desired output image including content, colors, textures, and style.",
                              "key": "prompt",
                              "value": "<string>",
                              "type": "text"
                            },
                            {
                              "description": "Text describing elements to exclude from the output image.",
                              "key": "negative_prompt",
                              "value": "<string>",
                              "type": "text"
                            },
                            {
                              "description": "Controls how closely the output follows the input sketch. Higher values produce outputs more faithful to the sketch structure.",
                              "key": "control_strength",
                              "value": "0.7",
                              "type": "text"
                            },
                            {
                              "description": "A value to control randomness in generation.",
                              "key": "seed",
                              "value": "0",
                              "type": "text"
                            },
                            {
                              "description": "The output format of the generated image. (This can only be one of jpeg,png,webp)",
                              "key": "output_format",
                              "value": "png",
                              "type": "text"
                            }
                          ]
                        },
                        "url": {
                          "raw": "{{baseUrl}}/v2beta/stable-image/control/sketch",
                          "host": [
                            "{{baseUrl}}"
                          ],
                          "path": [
                            "v2beta",
                            "stable-image",
                            "control",
                            "sketch"
                          ]
                        },
                        "description": "Generates a detailed image from a hand-drawn sketch or line drawing. The sketch provides the structural composition while the text prompt guides the content, colors, textures, and style of the output image."
