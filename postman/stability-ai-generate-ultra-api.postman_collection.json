                  "item": [
                    {
                      "name": "Generate an image using Stable Image Ultra",
                      "id": "e31443b6-35b5-4de4-92f7-84154addfd94",
                      "protocolProfileBehavior": {
                        "disableBodyPruning": true
                      },
                      "request": {
                        "method": "POST",
                        "header": [
                          {
                            "key": "Content-Type",
                            "value": "multipart/form-data"
                          },
                          {
                            "key": "Accept",
                            "value": "image/jpeg"
                          }
                        ],
                        "body": {
                          "mode": "formdata",
                          "formdata": [
                            {
                              "description": "(Required) Text describing what you wish to see in the output image. Strong, descriptive prompts that clearly define elements, colors, and subjects lead to better results.",
                              "key": "prompt",
                              "value": "<string>",
                              "type": "text"
                            },
                            {
                              "description": "Text describing elements to exclude from the output image.",
                              "key": "negative_prompt",
                              "value": "<string>",
                              "type": "text"
                            },
                            {
                              "description": "Controls the aspect ratio of the generated image. (This can only be one of 16:9,1:1,21:9,2:3,3:2,4:5,5:4,9:16,9:21)",
                              "key": "aspect_ratio",
                              "value": "1:1",
                              "type": "text"
                            },
                            {
                              "description": "A value to control randomness in generation. Set to 0 for a random seed. Using the same seed with the same parameters produces similar results.",
                              "key": "seed",
                              "value": "0",
                              "type": "text"
                            },
                            {
                              "description": "The output format of the generated image. (This can only be one of jpeg,png,webp)",
                              "key": "output_format",
                              "value": "png",
                              "type": "text"
                            }
                          ]
                        },
                        "url": {
                          "raw": "{{baseUrl}}/v2beta/stable-image/generate/ultra",
                          "host": [
                            "{{baseUrl}}"
                          ],
                          "path": [
                            "v2beta",
                            "stable-image",
                            "generate",
                            "ultra"
                          ]
                        },
                        "description": "Generates a high-quality image from a text prompt using the Stable Image Ultra model. This endpoint produces state-of-the-art results with exceptional detail, lighting, and composition. Requests use multipart form data encoding."
