  "info": {
    "_postman_id": "4b517f1b-2f2d-4df4-9c06-33ef67e9de4f",
    "name": "Stability AI Stable Fast 3D 3D Generation Outpaint API",
    "description": "The Stability AI Stable Fast 3D API generates textured 3D mesh assets from single input images. The API rapidly produces 3D models suitable for use in games, augmented reality, virtual reality, and product visualization workflows. Developers can convert 2D images into fully textured 3D objects with UV-unwrapped meshes, enabling rapid prototyping and asset creation without manual 3D modeling.\n\nContact Support:\n Name: Stability AI Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T03:01:58.000Z",
    "updatedAt": "2026-07-28T03:01:59.000Z",
