                        "header": [
                          {
                            "key": "Content-Type",
                            "value": "multipart/form-data"
                          },
                          {
                            "key": "Accept",
                            "value": "image/jpeg"
                          }
                        ],
                        "body": {
                          "mode": "formdata",
                          "formdata": [
                            {
                              "description": "(Required) The source image to extend.",
                              "key": "image",
                              "type": "file",
                              "value": null
                            },
                            {
                              "description": "Optional text describing what should appear in the extended regions.",
                              "key": "prompt",
                              "value": "<string>",
                              "type": "text"
                            },
                            {
                              "description": "Number of pixels to extend to the left.",
                              "key": "left",
                              "value": "<integer>",
                              "type": "text"
                            },
                            {
                              "description": "Number of pixels to extend to the right.",
                              "key": "right",
                              "value": "<integer>",
                              "type": "text"
                            },
                            {
                              "description": "Number of pixels to extend upward.",
                              "key": "up",
                              "value": "<integer>",
                              "type": "text"
                            },
                            {
                              "description": "Number of pixels to extend downward.",
                              "key": "down",
                              "value": "<integer>",
                              "type": "text"
                            },
                            {
                              "description": "A value to control randomness in generation.",
                              "key": "seed",
                              "value": "0",
                              "type": "text"
                            },
                            {
                              "description": "The output format of the edited image. (This can only be one of jpeg,png,webp)",
                              "key": "output_format",
                              "value": "png",
                              "type": "text"
                            }
                          ]
                        },
                        "url": {
                          "raw": "{{baseUrl}}/v2beta/stable-image/edit/outpaint",
                          "host": [
                            "{{baseUrl}}"
                          ],
                          "path": [
                            "v2beta",
                            "stable-image",
                            "edit",
                            "outpaint"
                          ]
                        },
                        "description": "Extends an image by generating new content beyond its current boundaries. Specify the number of pixels to extend in each direction and optionally provide a text prompt to guide the content of the extended regions. The generated content seamlessly continues the existing scene."
